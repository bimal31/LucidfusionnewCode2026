<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="true"
    android:orientation="vertical" >

    <ScrollView
        android:id="@+id/sv_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dip" >

            <TextView
                android:id="@+id/tv_lbl_pipe_standard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_pipe_standard"
                android:textColor="@android:color/white" />

            <Spinner
                android:id="@+id/spn_pipe_standard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/standard"
                android:background="@drawable/btn_dropdown_normal" />


            <TextView
                android:id="@+id/tv_lbl_machine_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_machine"
                android:textColor="@android:color/white" />

            <Spinner
                android:id="@+id/spn_machines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_dropdown_normal" />

            <TextView
                android:id="@+id/tv_lbl_pipe_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:text="@string/lbl_pipe_size"
                android:textColor="@android:color/white" />

            <Spinner
                android:id="@+id/spn_pipe_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_dropdown_normal" />

            <TextView
                android:id="@+id/tv_lbl_pipe_grade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:text="@string/lbl_pipe_grades"
                android:textColor="@android:color/white" />

            <Spinner
                android:id="@+id/spn_pipe_grades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_dropdown_normal" />

            <TextView
                android:id="@+id/tv_lbl_presure_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:text="@string/lbl_pressure_rating"
                android:textColor="@android:color/white" />

            <Spinner
                android:id="@+id/spn_pressure_rating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_dropdown_normal" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/tv_lbl_jointing_pressure"
                    android:layout_width="120dip"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_jointing_pressure"
                    android:textColor="@android:color/white" />

                <EditText
                    android:id="@+id/ed_jointing_pressure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dip"
                    android:background="@null"
                    android:enabled="false"
                    android:gravity="center"
                    android:minWidth="60dip"
                    android:padding="5dip"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/tv_jointing_pressure_kg"
                    android:layout_width="120dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dip"
                    android:text="@string/lbl_kg_cm"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/tv_lbl_drag_pressure"
                    android:layout_width="120dip"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_drag_pressure"
                    android:textColor="@android:color/white" />

                <EditText
                    android:id="@+id/ed_drag_pressure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dip"
                    android:background="@drawable/editbox_dropdown_background"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:maxLength="3"
                    android:minWidth="60dip"
                    android:padding="5dip"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/tv_drag_pressure_kg"
                    android:layout_width="120dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dip"
                    android:text="@string/lbl_kg_cm"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_calculate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="25dip"
                android:background="@drawable/btn_selecttor"
                android:paddingBottom="10dip"
                android:paddingLeft="30dip"
                android:paddingRight="30dip"
                android:paddingTop="10dip"
                android:text="@string/lbl_calc"
                android:textColor="@color/white" />

            <LinearLayout
                android:id="@+id/ll_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:background="@color/primary_color"
                android:orientation="vertical"
                android:padding="6dip"
                android:visibility="visible" >

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dip"
                    android:orientation="horizontal" >

                    <TextView
                        android:id="@+id/tv_lbl_t2_soaking_time"
                        android:layout_width="170dip"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_t2_soaking_time"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_soaking_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dip"
                    android:orientation="horizontal" >

                    <TextView
                        android:id="@+id/tv_lbl_t2_drag_pressure"
                        android:layout_width="170dip"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_drag_pressure"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_drag_pressure_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dip"
                    android:orientation="horizontal" >

                    <TextView
                        android:id="@+id/tv_lbl_t2_bead_time"
                        android:layout_width="170dip"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_t1_bead_up_time"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_t2_bead_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dip"
                    android:orientation="horizontal" >

                    <TextView
                        android:id="@+id/tv_lbl_welding_pressure"
                        android:layout_width="170dip"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_welding_pressure"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_welding_pressure_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dip"
                    android:orientation="horizontal" >

                    <TextView
                        android:id="@+id/tv_lbl_cooling_time"
                        android:layout_width="170dip"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_cooling_time"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_cooling_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dip"
                    android:orientation="horizontal" >

                    <TextView
                        android:id="@+id/tv_lbl_temprature"
                        android:layout_width="170dip"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_temprature"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_temprature_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>