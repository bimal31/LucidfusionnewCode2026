<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/ed_from_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:editable="false"
            android:focusable="false"
            android:background="@drawable/editbox_dropdown_background"
            android:padding="@dimen/edittext_padding"
            android:textColor="@color/black"
            android:cursorVisible="false"
            android:focusableInTouchMode="false"
            android:hint="Select from date"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btn_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cal" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/ed_to_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:editable="false"
            android:focusable="false"
            android:cursorVisible="false"
            android:textColor="@color/black"
            android:background="@drawable/editbox_dropdown_background"
            android:padding="@dimen/edittext_padding"
            android:focusableInTouchMode="false"
            android:hint="Select to date"/>

        <ImageView
            android:id="@+id/btn_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cal" />


    </LinearLayout>


    <Button
        android:id="@+id/btn_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search"
        android:minWidth="120dp"
        android:textColor="@color/white"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_selecttor"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:textSize="16sp"
        android:layout_gravity="center_horizontal"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white"
        android:layout_marginTop="10dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tvNoRecords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No Records Found"
            android:gravity="center"
            android:textSize="20sp"
            android:visibility="gone"
            android:textColor="@color/white"/>

        <ListView
            android:id="@+id/lv_data"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/white"
            android:dividerHeight="0.5dp"
            android:scrollbars="none"></ListView>

    </RelativeLayout>
</LinearLayout>