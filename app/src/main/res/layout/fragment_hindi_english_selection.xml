<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical" >

        <CheckBox
            android:id="@+id/chk_english"
            android:layout_width="120dip"
            android:layout_marginTop="30dip"
            android:layout_height="wrap_content"
            android:text="@string/lbl_english"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <CheckBox
            android:id="@+id/chk_hindi"
            android:layout_width="120dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dip"
            android:text="@string/lbl_hindi"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:visibility="visible" >

        <Button
            android:id="@+id/btn_calculate"
            android:layout_width="200dip"
            android:layout_height="wrap_content"
            android:layout_margin="5dip"
            android:background="@drawable/btn_selecttor"
            android:paddingBottom="4dip"
            android:paddingTop="4dip"
            android:text="@string/lbl_calc"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_report"
            android:layout_width="200dip"
            android:layout_height="wrap_content"
            android:layout_margin="5dip"
            android:background="@drawable/btn_selecttor"
            android:paddingBottom="4dip"
            android:paddingTop="4dip"
            android:text="@string/lbl_report"
            android:textColor="@color/white"
            android:textSize="16sp" />


        <Button
            android:id="@+id/btn_about"
            android:layout_width="200dip"
            android:layout_height="wrap_content"
            android:layout_margin="5dip"
            android:background="@drawable/btn_selecttor"
            android:paddingBottom="4dip"
            android:paddingTop="4dip"
            android:text="@string/lbl_terms"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_contact"
            android:layout_width="200dip"
            android:layout_height="wrap_content"
            android:layout_margin="5dip"
            android:background="@drawable/btn_selecttor"
            android:paddingBottom="4dip"
            android:paddingTop="4dip"
            android:text="@string/lbl_contact"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>